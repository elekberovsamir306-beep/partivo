# Partivo — environment template. Copy to .env.local (local) or set in Vercel (production).
# Never commit real values. Only NEXT_PUBLIC_* variables are exposed to the browser.

# Public site URL (no trailing slash). Production: https://partivo.az
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY — bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phone verification via Supabase Auth SMS (requires an SMS provider configured in Supabase)
NEXT_PUBLIC_PHONE_VERIFICATION=false

# Payments: epoint | mock | none
#   epoint — real payments (requires merchant keys below)
#   mock   — local test page, NEVER moves money, refused in production builds
#   none   — checkout disabled with a clear "not connected yet" message
PAYMENT_PROVIDER=none
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_API_BASE=https://epoint.az/api/1

# Random secrets (generate with: openssl rand -hex 32)
CRON_SECRET=
IP_HASH_SALT=
